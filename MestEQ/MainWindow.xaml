<Window x:Class="MestEQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MestEQ.Controls"
        xmlns:local="clr-namespace:MestEQ"
        Title="Mest EQ" Width="1360" Height="860" MinWidth="1120" MinHeight="720"
        Background="{StaticResource Velvet}" Foreground="{StaticResource Ivory}"
        FontFamily="{StaticResource Body}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:NumberConverter x:Key="Num" />
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Üst bant: marka, çalan şarkı, durum ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mest" Style="{StaticResource H1}" />
                <TextBlock Text="Kiwi Ears Altruva ile Moondrop Dawn Pro" Style="{StaticResource Small}" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NowTitle" Text="Şu an bir şey çalmıyor" FontFamily="{StaticResource Display}" FontSize="18"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowSub" Text="Spotify'da bir şarkı başlattığında burada görünür." Style="{StaticResource Small}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <TextBlock x:Name="AppliedName" Text="Nötr" FontFamily="{StaticResource Display}" FontSize="18"
                                   Foreground="{StaticResource Brass}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="AppliedWhy" Text="varsayılan preset" Style="{StaticResource Small}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="250">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ApoDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ApoText" Text="Ses motoru kontrol ediliyor" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="DevDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DevText" Text="Cihaz aranıyor" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>
                <Button x:Name="FixDeviceBtn" Content="Dawn Pro'da etkinleştir" Style="{StaticResource BrassBtn}" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Visibility="Collapsed" Click="FixDevice_Click" />
            </StackPanel>
        </Grid>

        <!-- ===== Orta alan ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Preset kütüphanesi -->
            <Border Style="{StaticResource Card}" Padding="10,12" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Presetler" Style="{StaticResource H2}" Margin="6,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Yeni preset" Style="{StaticResource Btn}" Click="NewPreset_Click" Margin="0,0,0,6" />
                        <UniformGrid Columns="2">
                            <Button Content="Kopyala" Style="{StaticResource Btn}" Click="DuplicatePreset_Click" Margin="0,0,3,0" />
                            <Button x:Name="DeleteBtn" Content="Sil" Style="{StaticResource Btn}" Click="DeletePreset_Click" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                    <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PresetItem}" SelectionChanged="PresetList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Small}" Margin="10,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding BindingCount}" Style="{StaticResource Small}" Margin="8,0,0,0"
                                               ToolTip="Bu presete bağlı şarkı, albüm ve sanatçı sayısı" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Grafik ve katmanlar -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <c:ResponseGraph x:Name="Graph" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,20,0,0">
                        <CheckBox x:Name="ShowBaseChk" IsChecked="True" Style="{StaticResource Switch}" Click="GraphLegend_Click" Margin="0,0,14,0">
                            <TextBlock Text="Kulaklık" Foreground="{StaticResource Slate}" FontSize="12" />
                        </CheckBox>
                        <CheckBox x:Name="ShowTasteChk" IsChecked="True" Style="{StaticResource Switch}" Click="GraphLegend_Click" Margin="0,0,14,0">
                            <TextBlock Text="Zevk" Foreground="{StaticResource Sage}" FontSize="12" />
                        </CheckBox>
                        <CheckBox x:Name="ShowPresetChk" IsChecked="True" Style="{StaticResource Switch}" Click="GraphLegend_Click" Margin="0,0,14,0">
                            <TextBlock Text="Preset" Foreground="{StaticResource Brass}" FontSize="12" />
                        </CheckBox>
                        <TextBlock Text="Toplam: kalın çizgi" Foreground="{StaticResource Ivory}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Tutamacı sürükle: frekans ve kazanç. Tekerlek: genişlik. Çift tık: yeni filtre. Sağ tık: sil. Shift: ince ayar."
                               Style="{StaticResource Small}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,22,0"
                               TextWrapping="NoWrap" Opacity="0.8" />
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                    <!-- Kulaklık düzeltmesi -->
                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="BaseChk" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Layer_Changed" />
                                <TextBlock Text="Kulaklık düzeltmesi" Style="{StaticResource H2}" Foreground="{StaticResource Slate}" />
                            </DockPanel>
                            <TextBlock x:Name="BaseSourceText" Style="{StaticResource Small}" Margin="0,0,0,10" />
                            <TextBlock x:Name="BaseCountText" Style="{StaticResource Num}" Margin="0,0,0,12" />
                            <Button Content="AutoEQ / squig eğrisi yapıştır" Style="{StaticResource Btn}" Click="ImportBase_Click" Margin="0,0,0,6" />
                            <Button Content="Başlangıç eğrisine dön" Style="{StaticResource Btn}" Click="ResetBase_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Zevk katmanı -->
                    <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="TasteChk" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Layer_Changed" />
                                <TextBlock Text="Zevkin" Style="{StaticResource H2}" Foreground="{StaticResource Sage}" />
                            </DockPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Bas" VerticalAlignment="Center" />
                                <Slider x:Name="BassSl" Grid.Column="1" Minimum="-6" Maximum="6" SmallChange="0.5" LargeChange="1" ValueChanged="Taste_Changed" ToolTip="105 Hz altı: davul gövdesi, kontrbas" />
                                <TextBlock x:Name="BassVal" Grid.Column="2" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="Sıcaklık" VerticalAlignment="Center" />
                                <Slider x:Name="WarmSl" Grid.Row="1" Grid.Column="1" Minimum="-6" Maximum="6" SmallChange="0.5" LargeChange="1" ValueChanged="Taste_Changed" ToolTip="250 Hz civarı: dolgunluk ya da çamur" />
                                <TextBlock x:Name="WarmVal" Grid.Row="1" Grid.Column="2" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="Varlık" VerticalAlignment="Center" />
                                <Slider x:Name="PresSl" Grid.Row="2" Grid.Column="1" Minimum="-6" Maximum="6" SmallChange="0.5" LargeChange="1" ValueChanged="Taste_Changed" ToolTip="3 kHz civarı: vokalin ve gitarın öne çıkması" />
                                <TextBlock x:Name="PresVal" Grid.Row="2" Grid.Column="2" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="Hava" VerticalAlignment="Center" />
                                <Slider x:Name="AirSl" Grid.Row="3" Grid.Column="1" Minimum="-6" Maximum="6" SmallChange="0.5" LargeChange="1" ValueChanged="Taste_Changed" ToolTip="10 kHz üstü: açıklık, salon havası" />
                                <TextBlock x:Name="AirVal" Grid.Row="3" Grid.Column="2" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Uzay ve seviye -->
                    <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Uzay ve seviye" Style="{StaticResource H2}" />
                            <DockPanel Margin="0,0,0,2">
                                <CheckBox x:Name="LoudChk" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Layer_Changed" />
                                <TextBlock Text="Loudness telafisi" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="LoudSl" Minimum="0" Maximum="1.5" SmallChange="0.1" LargeChange="0.25" ValueChanged="Space_Changed" ToolTip="Telafinin etkisi" />
                                <Button Grid.Column="1" Content="Bu seviye normal" Style="{StaticResource Btn}" Padding="8,3" Margin="8,0,0,0"
                                        Click="LoudnessRef_Click" ToolTip="Şu anki Windows ses seviyesini referans al: bunun altında bas ve tiz telafi edilir." />
                            </Grid>
                            <TextBlock x:Name="LoudInfo" Style="{StaticResource Small}" Margin="0,0,0,10" />

                            <DockPanel Margin="0,0,0,2">
                                <CheckBox x:Name="XfeedChk" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Layer_Changed" />
                                <TextBlock Text="Crossfeed" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider x:Name="XfeedSl" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" ValueChanged="Space_Changed"
                                    ToolTip="Eski stereo kayıtlarda tek kulağa yığılmış enstrümanları birleştirir" Margin="0,0,0,10" />

                            <DockPanel>
                                <TextBlock x:Name="BalVal" DockPanel.Dock="Right" Style="{StaticResource Num}" />
                                <TextBlock Text="Sol / sağ denge" />
                            </DockPanel>
                            <Slider x:Name="BalSl" Minimum="-1" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Space_Changed" MouseDoubleClick="BalReset_DoubleClick"
                                    ToolTip="Çift tık: ortala" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Preset düzenleyici -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="14,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox x:Name="PresetName" FontFamily="{StaticResource Display}" FontSize="17" TextChanged="PresetMeta_Changed" />
                        <TextBox x:Name="PresetNotes" Margin="0,8,0,0" Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" TextChanged="PresetMeta_Changed" />
                        <Grid Margin="0,14,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tür" Grid.Column="1" Style="{StaticResource Small}" />
                            <TextBlock Text="Hz" Grid.Column="2" Style="{StaticResource Small}" Margin="4,0,0,0" />
                            <TextBlock Text="dB" Grid.Column="3" Style="{StaticResource Small}" Margin="4,0,0,0" />
                            <TextBlock Text="Q" Grid.Column="4" Style="{StaticResource Small}" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Filtre ekle" Style="{StaticResource Btn}" Click="AddFilter_Click" Margin="0,0,3,0" />
                            <Button Content="APO metni yapıştır" Style="{StaticResource Btn}" Click="ImportPreset_Click" Margin="3,0,0,0" />
                        </UniformGrid>

                        <TextBlock Text="Bu preseti otomatik uygula" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <UniformGrid Columns="3">
                            <Button x:Name="BindTrackBtn" Content="Şarkıya" Style="{StaticResource Btn}" Click="BindTrack_Click" Margin="0,0,3,0" />
                            <Button x:Name="BindAlbumBtn" Content="Albüme" Style="{StaticResource Btn}" Click="BindAlbum_Click" Margin="3,0,3,0" />
                            <Button x:Name="BindArtistBtn" Content="Sanatçıya" Style="{StaticResource Btn}" Click="BindArtist_Click" Margin="3,0,0,0" />
                        </UniformGrid>
                        <TextBlock Text="Çalan şarkının bilgisiyle bağlar. Öncelik: şarkı, albüm, sanatçı, varsayılan." Style="{StaticResource Small}" Margin="0,6,0,6" />
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BindingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconBtn}" Tag="{Binding}" Click="Unbind_Click" ToolTip="Bağlantıyı kaldır" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button x:Name="DefaultBtn" Content="Eşleşme yoksa bunu kullan" Style="{StaticResource Btn}" Click="MakeDefault_Click" Margin="0,8,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FilterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Filtreyi aç/kapat" Cursor="Hand" />
                                        <Button Grid.Column="1" Content="{Binding KindLabel}" Style="{StaticResource Btn}" Padding="4,4" FontSize="12"
                                                Tag="{Binding}" Click="CycleKind_Click" ToolTip="Tıkla: tepe, alçak raf, yüksek raf" />
                                        <TextBox Grid.Column="2" Margin="4,0,0,0" Text="{Binding Freq, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" KeyDown="NumBox_KeyDown" />
                                        <TextBox Grid.Column="3" Margin="4,0,0,0" Text="{Binding Gain, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" KeyDown="NumBox_KeyDown" />
                                        <TextBox Grid.Column="4" Margin="4,0,0,0" Text="{Binding Q, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" KeyDown="NumBox_KeyDown" />
                                        <Button Grid.Column="5" Content="✕" Style="{StaticResource IconBtn}" Tag="{Binding}" Click="RemoveFilter_Click" ToolTip="Filtreyi sil" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Alt bant ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="EqOnChk" Style="{StaticResource Switch}" Click="EqOn_Click" VerticalAlignment="Center">
                    <TextBlock Text="EQ açık" FontWeight="SemiBold" />
                </CheckBox>
                <CheckBox x:Name="AutoChk" Grid.Column="1" Style="{StaticResource Switch}" Click="Auto_Click" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Şarkıya göre otomatik geçiş" />
                </CheckBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="AbToggle" Content="A / B" Style="{StaticResource Toggle}" Click="Ab_Click"
                                  ToolTip="Aynı algılanan ses seviyesinde iki ayarı karşılaştır. Basılıyken B çalar." />
                    <TextBlock x:Name="AbInfo" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,10,0" TextWrapping="NoWrap" />
                    <Button Content="B: EQ'suz" Style="{StaticResource Btn}" Click="AbFlat_Click" Margin="0,0,6,0" ToolTip="B tarafını tamamen düz (EQ'suz) yap" />
                    <Button Content="Bunu B'ye koy" Style="{StaticResource Btn}" Click="AbSelected_Click" ToolTip="Şu anki preseti B tarafına koy, sonra listeden başka bir preset seç" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="3" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="20,0,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Headroom" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="PreampText" Text="0.0 dB" FontFamily="{StaticResource Display}" FontSize="18" Foreground="{StaticResource Brass}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
